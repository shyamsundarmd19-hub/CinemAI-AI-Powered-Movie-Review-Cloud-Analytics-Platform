# CinemAI Backend Environment Variables
PROJECT_NAME="CinemAI - Movie Sentiment Analytics"
API_V1_STR="/api"
SECRET_KEY="replace_with_a_secure_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (AWS RDS PostgreSQL or Local PostgreSQL)
# Example AWS RDS: postgresql://postgres:mypassword@cinemai-rds.xxxxxx.us-east-1.rds.amazonaws.com:5432/cinemai_db
DATABASE_URL="postgresql://cinemai_user:cinemai_pass@localhost:5432/cinemai_db"

# AWS Free Tier Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
S3_BUCKET_NAME="cinemai-vault-storage"
SES_SENDER_EMAIL="noreply@cinemai.awsapps.com"
